rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A family is addressed by a long random code that only family members know.
    // Anyone holding the code can read and write that family's data, and nothing else.
    function codeOk(code) {
      return code is string && code.size() >= 16 && code.size() <= 64 && code.matches('^[a-z0-9]+$');
    }
    match /families/{code} {
      // Listing or reading the family document itself is not allowed, so codes cannot be enumerated.
      allow read, write: if false;

      match /data/{doc} {
        allow read: if codeOk(code) && doc == 'config';
        allow write: if codeOk(code) && doc == 'config' && request.resource.data.keys().hasAll(['familyName', 'members', 'tasks']);
      }
      match /days/{day} {
        allow read: if codeOk(code) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        allow write: if codeOk(code) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
